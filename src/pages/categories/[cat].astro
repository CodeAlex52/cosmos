---
import { getCollection } from "astro:content";
import HeadCommon from "../../components/HeadCommon.astro";
import Topbar from "../../components/Topbar.astro";
import CommandPalette from "../../components/CommandPalette.astro";
import "../../styles/archive.css";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	const cats = [...new Set(posts.map((p) => p.data.category).filter(Boolean))] as string[];
	return cats.map((c) => ({ params: { cat: c }, props: { cat: c } }));
}

const { cat } = Astro.props;
const posts = (await getCollection("posts"))
	.filter((p) => p.data.category === cat)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const fmt = (d: Date) =>
	`${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
---

<!doctype html>
<html lang="zh-CN">
<head>
	<HeadCommon title={`${cat} · Alex 的小宇宙`} description={`${cat}星区收录的全部文章`} />
</head>
<body class="post-body">
	<canvas id="sky-canvas" aria-hidden="true"></canvas>
	<div class="glow" aria-hidden="true"></div>

	<Topbar mode="inner" />

	<main class="article arch">
		<p class="eyebrow"><span>SECTOR</span><span class="dot">·</span><span data-decode>{posts.length} 篇星辰</span></p>
		<h1>{cat}</h1>
		<p class="sub">{cat}——这里收着与它相关的每一次观察、推演与记录。</p>

		<div class="rule"></div>

		<ul class="timeline">
			{posts.map((p) => (
				<li class="arch-item">
					<a
						class="arch-card"
						href={`/posts/${p.id}/`}
						data-spotlight
						data-cursor="READ"
						data-thumb={p.data.image || ""}
					>
						<div class="arch-top">
							<span class="arch-date">{fmt(p.data.published)}</span>
							<span class="arch-cat">{cat}</span>
						</div>
						<h2 class="arch-title">{p.data.title}</h2>
						{p.data.description && <p class="arch-desc">{p.data.description}</p>}
						{p.data.tags?.length > 0 && (
							<div class="arch-tags">
								{p.data.tags.map((t) => <span>#{t}</span>)}
							</div>
						)}
					</a>
				</li>
			))}
		</ul>

		<div class="foot-bottom" style="margin-top: 56px;">
			<a class="back" href="/archive/">← 全部归档</a>
			<a class="back" href="/">回到星图 →</a>
		</div>
	</main>

	<div class="thumb-preview" id="thumb-preview" aria-hidden="true">
		<img id="thumb-img" src="" alt="" />
	</div>

	<script>
		import "../../lib/sky.js";

		const preview = document.getElementById("thumb-preview");
		const previewImg = document.getElementById("thumb-img") as HTMLImageElement | null;
		let activeThumb = "";

		document.querySelectorAll("[data-thumb]").forEach((card) => {
			card.addEventListener("pointerenter", () => {
				const src = card.getAttribute("data-thumb") || "";
				if (!src || !preview || !previewImg) return;
				if (activeThumb !== src) {
					activeThumb = src;
					previewImg.src = src;
				}
				preview.classList.add("is-visible");
			});
			card.addEventListener("pointermove", (e: Event) => {
				const pe = e as PointerEvent;
				if (!preview || !preview.classList.contains("is-visible")) return;
				const x = Math.min(window.innerWidth - 240, pe.clientX + 24);
				const y = Math.min(window.innerHeight - 150, Math.max(80, pe.clientY - 40));
				preview.style.left = `${x}px`;
				preview.style.top = `${y}px`;
			});
			card.addEventListener("pointerleave", () => {
				preview?.classList.remove("is-visible");
			});
		});
	</script>

	<CommandPalette />
</body>
</html>
