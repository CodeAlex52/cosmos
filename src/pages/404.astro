---
import HeadCommon from "../components/HeadCommon.astro";
import Topbar from "../components/Topbar.astro";
import CommandPalette from "../components/CommandPalette.astro";
import "../styles/post.css";
---

<!doctype html>
<html lang="zh-CN">
<head>
	<HeadCommon title="迷失在星际 · Alex 的小宇宙" description="信号越过事件视界，这里没有星" />
</head>
<body class="post-body">
	<canvas id="sky-canvas" data-mode="blackhole" aria-hidden="true"></canvas>
	<div class="glow" aria-hidden="true"></div>

	<Topbar mode="inner" />

	<main class="void-hero">
		<div class="void-card" data-spotlight>
			<p class="eyebrow"><span>404</span><span class="dot">·</span><span data-decode>EVENT HORIZON</span></p>
			<h1>这里没有星</h1>
			<p class="sub">你要找的那颗星，可能已经滑落进事件视界，也可能从未在这个星区亮过。</p>
			<a class="warp-cta" href="/" data-magnetic data-cursor="WARP">
				<span>← 跃迁回星图</span>
			</a>
		</div>
	</main>

	<script>
		import "../lib/sky.js";
	</script>

	<CommandPalette />
</body>
</html>
