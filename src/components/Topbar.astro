---
interface Props {
	mode?: "home" | "inner";
	aboutStopIndex?: number;
}

const { mode = "inner", aboutStopIndex = 3 } = Astro.props;
---

<header class="topbar">
	<a class="brand" href="/" data-magnetic>
		<svg class="brand-orbit" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="0.9" stroke-dasharray="2.4 2.8" opacity="0.72" />
			<circle cx="12" cy="12" r="2.2" fill="currentColor" />
			<circle cx="19.5" cy="8.5" r="1.3" fill="currentColor" opacity="0.9" />
		</svg>
		<span>Alex</span>
	</a>

	<nav class="nav" aria-label="主导航">
		{mode === "home" ? (
			<>
				<a href="#stop-1" data-magnetic>博客</a>
				<a href="/archive/" data-magnetic>归档</a>
				<a href="https://board.664501775.workers.dev" target="_blank" rel="noopener" data-magnetic>记录</a>
				<a href={`#stop-${aboutStopIndex}`} data-magnetic>关于</a>
			</>
		) : (
			<>
				<a href="/archive/" data-magnetic>归档</a>
				<a href="https://board.664501775.workers.dev" target="_blank" rel="noopener" data-magnetic>记录</a>
				<a href="/" data-magnetic>星图</a>
			</>
		)}

		<div class="nav-tools">
			<button type="button" class="cmd-pill" data-cmd-open data-magnetic data-cursor="INDEX" aria-label="打开宇宙索引 (⌘K)">
				<span class="cmd-pill-icon">⌘K</span>
				<span class="cmd-pill-txt">索引</span>
			</button>

			<button type="button" class="audio-btn" data-audio-toggle data-magnetic data-cursor="SOUND" aria-pressed="false" aria-label="开启宇宙声景">
				<i></i><i></i><i></i><i></i>
			</button>

			<button type="button" class="theme-btn" data-theme-toggle data-magnetic data-cursor="ECLIPSE" aria-label="切换明暗">
				<span class="tb-sun">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
						<circle cx="12" cy="12" r="4.2" />
						<path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6" />
					</svg>
				</span>
				<span class="tb-moon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
						<path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.7 8.7 0 1 0 11.1 11.1z" />
					</svg>
				</span>
			</button>
		</div>
	</nav>
</header>
